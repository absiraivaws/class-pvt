# PostgreSQL / Supabase connection string
#
# Use the Supabase "Session pooler" (IPv4, port 5432) — works both locally and
# on Vercel (serverless). Do NOT use the direct IPv6 connection on Vercel.
#   Project Settings -> Database -> Connection string -> Session pooler
#   Example (region ap-southeast-1):
#   postgresql://postgres.mvkhxkcormicwekyjpuh:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres.mvkhxkcormicwekyjpuh:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=public"

# Supabase project credentials (Supabase JS client / future Auth & Storage)
#   Project Settings -> API
SUPABASE_URL="https://mvkhxkcormicwekyjpuh.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_xxxxxxxx"

# Session / JWT secret (generate with: openssl rand -base64 32)
# REQUIRED in production (Vercel) - use a long random value.
SESSION_SECRET="change-me-in-production"

# Application base URL (set to your Vercel URL in production)
APP_URL="http://localhost:3000"

# Email (SMTP). Leave SMTP_HOST empty to log emails to console in development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@example.com"

# Payment provider: "mock" for development. Set to "lankaqr" once integrated.
PAYMENT_PROVIDER="mock"
# LankaQR provider credentials (future)
LANKAQR_API_URL=""
LANKAQR_MERCHANT_ID=""
LANKAQR_API_SECRET=""
LANKAQR_WEBHOOK_SECRET=""

# Dynamic QR expiry in minutes
QR_EXPIRY_MINUTES="10"
