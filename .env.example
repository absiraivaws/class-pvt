# PostgreSQL / Supabase connection string
#
# LOCAL: point at your local Postgres (see docker-compose.yml, port 5433).
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/student_payment?schema=public"
#
# SUPABASE / VERCEL (serverless): use the Supabase "Session pooler" / IPv4
# connection string (port 5432 or 6543), NOT the direct IPv6 connection.
#   Project Settings -> Database -> Connection string -> Session pooler
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_payment?schema=public"

# Session / JWT secret (generate with: openssl rand -base64 32)
# REQUIRED in production (Vercel) - use a long random value.
SESSION_SECRET="change-me-in-production"

# Application base URL (set to your Vercel URL in production)
APP_URL="http://localhost:3000"

# Email (SMTP). Leave SMTP_HOST empty to log emails to console in development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@example.com"

# Payment provider: "mock" for development. Set to "lankaqr" once integrated.
PAYMENT_PROVIDER="mock"
# LankaQR provider credentials (future)
LANKAQR_API_URL=""
LANKAQR_MERCHANT_ID=""
LANKAQR_API_SECRET=""
LANKAQR_WEBHOOK_SECRET=""

# Dynamic QR expiry in minutes
QR_EXPIRY_MINUTES="10"
